# ============================================================
# LLM（OpenAI 兼容协议，必填）
# ============================================================
# 默认 DeepSeek
OPENAI_API_KEY=your-deepseek-key
OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_MODEL=deepseek-chat

# 若用 DashScope（国产，chat + embedding 同 key）：
# OPENAI_API_KEY=sk-your-dashscope-key
# OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# OPENAI_MODEL=qwen-plus

# ============================================================
# 知识库（默认开启，无需任何参数）
# ============================================================
# 知识（含向量）落盘路径；不填默认 ./knowledge_index.json
# KNOWLEDGE_INDEX=knowledge_index.json

# ============================================================
# 语义 embedding（选配：不配则知识检索退化为关键词 BM25）
# ============================================================
# 方式一（推荐）：本地 HuggingFace 模型，离线 / 数据不出机器
#   模型目录由 transformers 加载（与 localpy/agent.py 同款方式）
# EMBEDDING_MODEL_PATH=/Users/dovewang/newWork/test/localpy/dir-embed

# 方式二：API（EMBEDDING_MODEL_PATH 留空时才生效）
# EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# EMBEDDING_MODEL=text-embedding-v3
# （本地 Ollama 网关：EMBEDDING_BASE_URL=http://localhost:11434/v1, EMBEDDING_MODEL=nomic-embed-text）

# ============================================================
# MCP servers（选配：写 JSON 文件即加载，也可用变量指定路径）
# ============================================================
# MCP_CONFIG=/absolute/path/to/mcp_servers.json
# 默认自动读工作目录下的 ./mcp_servers.json（不存在则不接入）

